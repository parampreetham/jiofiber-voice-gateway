# ==============================================================================
# JioFiber Voice Gateway Configuration Template
# Rename this file to .env or use the in-app Setup Wizard on first launch.
# ==============================================================================

# JioFiber Router IP (Default Jio router is 192.168.29.1, or custom like 192.168.31.1)
JIO_ROUTER_HOST=192.168.29.1

# Router SIP-TLS Port (Default: 5068)
JIO_ROUTER_PORT=5068

# Your 10-digit Jio landline number with country code (e.g., +918132796216)
JIO_LANDLINE_NUMBER=+91XXXXXXXXXX

# 32-character MD5 SIP authentication digest password provisioned by Jio
JIO_SIP_PASSWORD=your_32_character_sip_password_here

# IMS Realm for your circle (e.g., ka.wln.ims.jio.com for Karnataka, dl.wln.ims.jio.com for Delhi)
JIO_IMS_REALM=ka.wln.ims.jio.com

# Client UUID (Unique identifier or 00000000-0000-1000-8000-000085EA2C9F)
JIO_CLIENT_UUID=00000000-0000-1000-8000-000085EA2C9F

# HTTP / WebSocket Server Port (Default: 8088)
PORT=8088
